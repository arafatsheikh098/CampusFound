# CampusFound environment configuration
# Copy to .env for local development.

# Application environment: "development" or "production"
ENV=development

# Secret used to sign session cookies. MUST be a long random string in production.
# Default value is rejected at startup when ENV=production.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Database URL. For local SQLite, use sqlite:///./campusfound.db
# For Docker / Postgres: postgresql+psycopg://campusfound:campusfound@db:5432/campusfound
DATABASE_URL=sqlite:///./campusfound.db

# Comma-separated list of trusted proxy IPs / CIDR for X-Forwarded-Proto etc.
# In Docker behind Render's proxy, set to "*" or leave empty to trust all.
TRUSTED_HOSTS=*

# Item lifecycle (days). All have sensible defaults.
DAYS_DATE_FOUND_MAX=60
DAYS_CLAIM_EXPIRY=7
DAYS_PURGE_AFTER=90

# Optional Telegram integration. Leave TELEGRAM_BOT_TOKEN empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Demo mode: 1 shows a banner, hides real-user links, allows seed.
DEMO_MODE=0
